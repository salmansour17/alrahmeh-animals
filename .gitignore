# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Runtime data: the SQLite file is created on startup, never committed
data/
*.db
*.sqlite3

# Test artefacts
.coverage
htmlcov/
.pytest_cache/

# Node toolchain (website build dependencies)
node_modules/
npm-debug.log*

# The built website. No longer committed: the pipeline builds ui/ and uploads
# the result to the static website, so a committed copy could only go stale.
ui/dist/

# Local environment overrides
.env

# OS
.DS_Store
Thumbs.db

# Terraform: downloaded providers and any local state. The lock file
# (infra/.terraform.lock.hcl) IS committed, so CI and CD use the exact provider
# version that was validated.
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
