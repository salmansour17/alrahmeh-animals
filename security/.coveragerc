[run]
source = .
omit = tests/*

[report]
show_missing = true
# The scanners decide whether a deploy goes ahead, so their own tests must
# reach nearly every line. The `if __name__ == "__main__"` line only runs as a
# script.
fail_under = 95
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
